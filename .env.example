# Required — app will not start without these
GROQ_API_KEY=
# Local Docker Postgres: docker compose up -d postgres
DATABASE_URL=your_postgresql_connection_url

# Required when agents use MCP search / flights
TAVILY_API_KEY=your_tavily_api_key
AVIATION_STACK_API_KEY=your_aviation_stack_api_key

# Optional — LangSmith tracing (LangChain reads these automatically)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=BlitzPilot-AI

FLIGHT_API_KEY=your_flight_api_key
WEATHER_API_KEY=your_weather_api_key    